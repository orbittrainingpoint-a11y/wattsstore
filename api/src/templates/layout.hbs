      .footer { padding: 20px 28px; font-size: 12px; color: #4A5568; border-top: 1px solid #eee; }
      .mono { font-family: 'Courier New', monospace; background: #F7F9FC; padding: 2px 6px; border-radius: 4px; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="header"><h1>⚡ Watts<span>Store</span></h1></div>
