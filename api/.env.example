# ───── WattsStore API — Environment Template ─────
# Copy to `.env` and fill in. NEVER commit `.env`. chmod 600 on servers.

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# CORS — comma-separated whitelist of allowed origins
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql://wattsstore:wattsstore_dev_pw@localhost:5432/wattsstore_db?schema=public

# ── Redis (cache + BullMQ + rate-limit store) ──
REDIS_URL=redis://localhost:6379

# ── JWT / Auth ──
# Generate strong secrets: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost
BCRYPT_COST=12

# ── MinIO (S3-compatible object storage) ──
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=wattsstore
MINIO_SECRET_KEY=wattsstore_dev_pw
MINIO_BUCKET=wattsstore
MINIO_PUBLIC_URL=http://localhost:9000

# ── SMTP (Nodemailer transactional email) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WattsStore <no-reply@wattsstore.com>"
SALES_TEAM_EMAIL=sales@wattsstore.com
ADMIN_ALERT_EMAIL=admin@wattsstore.com

# ── Payments ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=

# ── Rate limiting (overridable) ──
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MIN=15
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MIN=1

# ── Company details (used on invoices) ──
COMPANY_NAME=WattsStore FZE
COMPANY_ADDRESS=Dubai, United Arab Emirates
COMPANY_TRN=100000000000003
